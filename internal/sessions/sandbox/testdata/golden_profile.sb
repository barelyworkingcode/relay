(version 1)
(allow default)
(deny file-read* file-write*)
(allow file-read*
  (literal "/")
  (literal "/var")
  (literal "/etc")
  (literal "/tmp")
  (subpath "/usr")
  (subpath "/System/Library")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/private/var/select"))
(deny file-read* file-write*
  (subpath "/usr/local/etc")
  (subpath "/usr/local/var"))
(allow file-read*
  (literal "/usr/local/etc/openssl@3/cert.pem")
  (literal "/usr/local/etc/ca-certificates/cert.pem")
  (literal "/usr/local/etc/gitconfig"))
(allow file-read*
  (subpath "/private/tmp/relay-sandbox-golden/opt/homebrew")
  (literal "/private/tmp/relay-sandbox-golden/home/.gitconfig"))
(allow file-read* file-write*
  (subpath "/private/tmp/relay-sandbox-golden/projects/widget")
  (subpath "/private/tmp/relay-sandbox-golden/home/.cache")
  (subpath "/private/tmp/relay-sandbox-golden/home/go/pkg")
  (subpath "/private/tmp/cc-socks")
  (subpath "/dev")
  (regex #"^/private/tmp/relay-sandbox-golden/home/\.claude\.json(\.lock|\.tmp\.[^/]*|\.backup)?$"))
(allow file-read-metadata
  (literal "/System")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/tmp/relay-sandbox-golden")
  (literal "/private/tmp/relay-sandbox-golden/home")
  (literal "/private/tmp/relay-sandbox-golden/home/go")
  (literal "/private/tmp/relay-sandbox-golden/opt")
  (literal "/private/tmp/relay-sandbox-golden/projects")
  (literal "/private/var")
  (literal "/private/var/db")
  (literal "/usr")
  (literal "/usr/local")
  (literal "/usr/local/etc")
  (literal "/usr/local/etc/ca-certificates")
  (literal "/usr/local/etc/openssl@3"))
(deny network-outbound
  (remote unix-socket (path-literal "/private/tmp/relay-sandbox-golden/relayllm/router.sock"))
  (remote unix-socket (path-regex #"^/private/tmp/relay-sandbox-golden/relay/")))
(allow network-outbound
  (remote unix-socket (path-literal "/private/tmp/relay-sandbox-golden/relay/relay.sock"))
  (remote unix-socket (path-literal "/private/tmp/relay-sandbox-golden/relay/model.sock")))
(deny network-outbound
  (remote ip "localhost:3000")
  (remote ip "localhost:8181"))
(allow network-outbound
  (remote ip "localhost:8180"))
(deny process-exec* (require-any (file-mode #o4000) (file-mode #o2000)))
