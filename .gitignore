# IDE
.idea/

# Build artifacts. These are binaries at the repository root, so the patterns
# are anchored: a bare name matches any path component, which would swallow
# cmd/relay and hide every file added there.
*.app
*.dSYM/
bin/
/relay
/relaygo
/macmcp

# OS
.DS_Store

# Go
*.exe
*.test
*.out

# Python
__pycache__/
*.pyc

# Environment
.env

# Scratch
prompt.md
/plans/

# Agent worktrees
.claude/
