#!/usr/bin/env bash
# Pre-push hook: build and vet, once per push rather than once per commit.
#
# This is deliberate: do not set core.hooksPath to .githooks. A global hooks
# dispatcher runs this file, and pointing hooksPath here bypasses the
# dispatcher's own push checks.
#
# Skip on emergency:
#   git push --no-verify
#
# What runs:
#   go build ./...  — only when the commits being pushed touch Go sources
#   go vet ./...    — likewise
#
# gofmt, the tagged vet and the no-_test.go check are CI's job
# (.github/workflows/ci.yml, every PR and main).

set -e

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
touches_go=false

# git feeds one line per ref being pushed.
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a remote ref
    if [ "$remote_sha" = "$zero" ]; then
        # A new branch has no remote side to diff against; measure it from
        # where it left main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    else
        base=$remote_sha
    fi
    # No usable base (unfetched remote sha, no origin/main): run the checks
    # rather than guess.
    if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
        touches_go=true
        break
    fi
    if git diff --name-only "$base" "$local_sha" | grep -qE '\.(go|mod|sum|m|h)$|^web/'; then
        touches_go=true
        break
    fi
done

if [ "$touches_go" = false ]; then
    exit 0
fi

start=$(date +%s)

echo "→ go build ./..."
if ! go build ./...; then
    echo "✗ build failed; push aborted"
    exit 1
fi

echo "→ go vet ./..."
if ! go vet ./...; then
    echo "✗ vet failed; push aborted"
    exit 1
fi

elapsed=$(($(date +%s) - start))
echo "✓ pre-push checks passed in ${elapsed}s"
