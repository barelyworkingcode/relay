#!/usr/bin/env bash
# Pre-push hook: the hermetic suite, once per push rather than once per commit.
#
# Install once per clone (same setting enables the pre-commit hook):
#   git config core.hooksPath .githooks
#
# Skip on emergency:
#   git push --no-verify
#
# What runs:
#   go test ./...   — only when the commits being pushed touch Go sources
#
# The race detector is CI's job (.github/workflows/ci.yml, every PR and main).
# The suite expects relay stopped: a running instance rewrites the real
# settings.json and trips support_safety_test.go.

set -e

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
touches_go=false

# git feeds one line per ref being pushed.
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a remote ref
    if [ "$remote_sha" = "$zero" ]; then
        # A new branch has no remote side to diff against; measure it from
        # where it left main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    else
        base=$remote_sha
    fi
    # No usable base (unfetched remote sha, no origin/main): run the suite
    # rather than guess.
    if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
        touches_go=true
        break
    fi
    if git diff --name-only "$base" "$local_sha" | grep -qE '\.(go|mod|sum|m|h)$|^test/|^testdata/|^web/'; then
        touches_go=true
        break
    fi
done

if [ "$touches_go" = false ]; then
    exit 0
fi

start=$(date +%s)

echo "→ go test ./..."
if ! go test ./...; then
    echo "✗ tests failed; push aborted"
    echo "  (rerun with: go test -v ./...)"
    exit 1
fi

elapsed=$(($(date +%s) - start))
echo "✓ pre-push checks passed in ${elapsed}s"
