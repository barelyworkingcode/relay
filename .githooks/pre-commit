#!/usr/bin/env bash
# Pre-commit hook: the checks that cost seconds.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Skip on emergency:
#   git commit --no-verify
#
# What runs:
#   1. gofmt -l on the staged Go files
#   2. go build ./...
#   3. go vet ./...
#
# What does NOT run here, and where it runs instead (docs/testing.md):
#   - go test ./...        pre-push hook, and CI on every PR
#   - go test -race ./...  CI on every PR and on main
#   - -tags=live           by hand

set -e

cd "$(git rev-parse --show-toplevel)"

staged_go=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.go$' || true)

if [ -z "$staged_go" ] && ! git diff --cached --name-only | grep -qE '\.(mod|sum)$'; then
    exit 0
fi

start=$(date +%s)

if [ -n "$staged_go" ]; then
    echo "→ gofmt"
    # Reads the working-tree file, not the staged blob: a partially staged file
    # is judged on what is on disk.
    unformatted=$(echo "$staged_go" | xargs gofmt -l)
    if [ -n "$unformatted" ]; then
        echo "✗ not gofmt-clean; commit aborted:"
        echo "$unformatted" | sed 's/^/    /'
        exit 1
    fi
fi

echo "→ go build ./..."
if ! go build ./...; then
    echo "✗ build failed; commit aborted"
    exit 1
fi

echo "→ go vet ./..."
if ! go vet ./...; then
    echo "✗ vet failed; commit aborted"
    exit 1
fi

elapsed=$(($(date +%s) - start))
echo "✓ pre-commit checks passed in ${elapsed}s"
